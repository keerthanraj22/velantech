# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# MySQL database. Create a real .env file from this template and enter your password.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="agriequip_connect"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
# Tune this to the capacity of the MySQL server.
MYSQL_CONNECTION_LIMIT="20"

# AI: Create a Gemini API key in Google AI Studio and keep it server-side.
# Without this key, the advisor clearly switches to local guidance mode.
GEMINI_API_KEY="your_gemini_api_key"
# Keep the paid AI API responsive under bursts of traffic.
AI_MAX_CONCURRENT_REQUESTS="8"
AI_MAX_QUEUE_SIZE="40"
AI_RATE_LIMIT_PER_MINUTE="20"

# Optional integrations
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRE="7d"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Payment adapter: use `mock` only for local/demo mode. Live gateways require
# server-side signature verification and a provider-specific webhook adapter.
PAYMENT_GATEWAY="mock"
PAYMENT_GATEWAY_SECRET=""
PLATFORM_COMMISSION_PERCENT="10"
PAYOUT_RELEASE="rental_completed"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
